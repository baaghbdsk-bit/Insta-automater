# Copy to .env for local runs. In GitHub Actions these come from repository secrets.
# Never commit .env.

# ---------- Content generation (Gemini via its OpenAI-compatible endpoint) ----------
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai
LLM_API_KEY=
LLM_MODEL=gemini-3-flash-preview,gemini-3.6-flash,gemini-3.8-flash

# Optional: only used to report token expiry and for token:exchange
FB_APP_ID=
FB_APP_SECRET=
FB_PAGE_ID=

# ---------- Instagram (Meta Graph API) ----------
# Needs a Facebook Page + IG Business/Creator account linked to it + a Meta app
# with instagram_content_publish and instagram_manage_insights.
IG_USER_ID=
IG_ACCESS_TOKEN=
FB_PAGE_TOKEN=
# Upload transport: 'direct' (resumable, no hosting) or 'url' (R2).
IG_UPLOAD_MODE=direct

# ---------- Cloudflare R2 (public video hosting) ----------
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
# Public base URL for the bucket, e.g. https://cdn.example.com (no trailing slash)
R2_PUBLIC_BASE=

# ---------- Optional ----------
# Pexels gives better photos than Openverse. Without it, Openverse (CC0) is used.
PEXELS_API_KEY=
# Enable AI image generation; leave empty unless the key has image quota.
GEMINI_IMAGE_MODEL=
# Discord or Slack incoming webhook for failure notifications.
NOTIFY_WEBHOOK_URL=

# ---------- Behaviour ----------
# 1 = build but never publish
DRY_RUN=0
# 1 = do nothing at all
KILL_SWITCH=0
# 1 = prefer the curated local photo pool over remote providers
PHOTO_FROM_LOCAL=0
# Override the ffmpeg binaries (CI uses the distro build, which has libass)
FFMPEG_PATH=
FFPROBE_PATH=

# ---------- Music (Instagram Audio API) ----------
# 1 = attach the licensed track to the Reel natively (and mux the same file for YouTube)
IG_NATIVE_AUDIO=1
# original_sound = real songs/edits used on Reels (default). music = stock catalogue.
IG_AUDIO_TYPE=original_sound
# 1 = use the curated pool in src/music-picks.js before falling back to search
IG_AUDIO_CURATED=1
# 1 = use files in assets/music/custom/<mood>/ before anything else
MUSIC_CUSTOM=1
# Meta accepts 1-100; 0 publishes the Reel as "Original audio"
IG_NATIVE_AUDIO_VIDEO_VOLUME=1
